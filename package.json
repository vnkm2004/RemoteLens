{
  "name": "remote-camera-sync",
  "version": "1.0.0",
  "type": "module",
  "description": "Zero-degradation Remote Camera Sharing and Capture across devices over Wi-Fi / Hotspot with offline APK support",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "node server/server.js",
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client install && npm --prefix client run build",
    "android:sync": "npm --prefix client run cap:sync",
    "android:open": "cd client && npx cap open android"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "keywords": [
    "webrtc",
    "remote-camera",
    "lossless-capture",
    "imagecapture-api",
    "offline-wifi"
  ],
  "author": "",
  "license": "ISC"
}
