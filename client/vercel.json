{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/download/apk",
      "destination": "/RemoteLens.apk"
    },
    {
      "source": "/((?!RemoteLens\\.apk).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/RemoteLens.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"RemoteLens.apk\""
        }
      ]
    }
  ]
}
